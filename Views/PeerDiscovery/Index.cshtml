@using AIstudentskillexchange.Models
@using AIstudentskillexchange.Models.ViewModels.PeerSearch
@model PeerSearchViewModel
@{
    ViewData["Title"] = "Find Peers";

    // Carries the current filters onto paging links.
    Dictionary<string, string?> PageLink(int page) => new()
    {
        ["query"] = Model.Criteria.Query,
        ["skillId"] = Model.Criteria.SkillId?.ToString(),
        ["category"] = Model.Criteria.Category,
        ["level"] = Model.Criteria.Level?.ToString(),
        ["skillType"] = Model.Criteria.SkillType?.ToString(),
        ["onlyMatchingMyGoals"] = Model.Criteria.OnlyMatchingMyGoals.ToString(),
        ["onlyWantingMySkills"] = Model.Criteria.OnlyWantingMySkills.ToString(),
        ["sort"] = Model.Criteria.Sort.ToString(),
        ["page"] = page.ToString()
    };
}

<div class="mb-3">
    <h1 class="h3 mb-1">Find Peers</h1>
    <p class="text-muted mb-0">
        Search students by skill, category or name, and see how each one matches your profile.
    </p>
</div>

@if (Model.ViewerHasNoProfile)
{
    <div class="alert alert-info">
        <strong>Your profile is empty.</strong>
        You can still search, but adding the skills you can teach and the ones you want to learn
        lets us show how well each student matches you.
    </div>
}

<form method="get" class="card card-body bg-light border-0 mb-4">
    <div class="row g-2">
        <div class="col-12 col-lg-4">
            <label class="form-label mb-1" for="query">Search</label>
            <input type="text" class="form-control" id="query" name="query"
                   value="@Model.Criteria.Query" placeholder="Name, bio or skill" />
        </div>

        <div class="col-6 col-lg-2">
            <label class="form-label mb-1" for="skillId">Skill</label>
            <select class="form-select" id="skillId" name="skillId">
                <option value="">Any skill</option>
                @foreach (var skill in Model.AllSkills)
                {
                    if (Model.Criteria.SkillId == skill.Id)
                    {
                        <option value="@skill.Id" selected>@skill.Name</option>
                    }
                    else
                    {
                        <option value="@skill.Id">@skill.Name</option>
                    }
                }
            </select>
        </div>

        <div class="col-6 col-lg-2">
            <label class="form-label mb-1" for="category">Category</label>
            <select class="form-select" id="category" name="category">
                <option value="">Any category</option>
                @foreach (var category in Model.AllCategories)
                {
                    if (string.Equals(Model.Criteria.Category, category, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@category" selected>@category</option>
                    }
                    else
                    {
                        <option value="@category">@category</option>
                    }
                }
            </select>
        </div>

        <div class="col-6 col-lg-2">
            <label class="form-label mb-1" for="skillType">They</label>
            <select class="form-select" id="skillType" name="skillType">
                <option value="">Teach or learn</option>
                <option value="@SkillType.ToTeach" selected="@(Model.Criteria.SkillType == SkillType.ToTeach)">Can teach it</option>
                <option value="@SkillType.ToLearn" selected="@(Model.Criteria.SkillType == SkillType.ToLearn)">Want to learn it</option>
            </select>
        </div>

        <div class="col-6 col-lg-2">
            <label class="form-label mb-1" for="level">Level</label>
            <select class="form-select" id="level" name="level">
                <option value="">Any level</option>
                @foreach (var level in Enum.GetValues<ProficiencyLevel>())
                {
                    if (Model.Criteria.Level == level)
                    {
                        <option value="@level" selected>@level</option>
                    }
                    else
                    {
                        <option value="@level">@level</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="row g-2 mt-1 align-items-end">
        <div class="col-12 col-lg-8">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="onlyMatchingMyGoals"
                       name="onlyMatchingMyGoals" value="true"
                       checked="@Model.Criteria.OnlyMatchingMyGoals" />
                <label class="form-check-label small" for="onlyMatchingMyGoals">
                    Only peers who teach what I want to learn
                </label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="onlyWantingMySkills"
                       name="onlyWantingMySkills" value="true"
                       checked="@Model.Criteria.OnlyWantingMySkills" />
                <label class="form-check-label small" for="onlyWantingMySkills">
                    Only peers who want what I can teach
                </label>
            </div>
        </div>

        <div class="col-6 col-lg-2">
            <label class="form-label mb-1" for="sort">Sort by</label>
            <select class="form-select" id="sort" name="sort">
                <option value="@PeerSortOrder.BestMatch" selected="@(Model.Criteria.Sort == PeerSortOrder.BestMatch)">Best match</option>
                <option value="@PeerSortOrder.Name" selected="@(Model.Criteria.Sort == PeerSortOrder.Name)">Name</option>
                <option value="@PeerSortOrder.MostSkillsTaught" selected="@(Model.Criteria.Sort == PeerSortOrder.MostSkillsTaught)">Most skills taught</option>
            </select>
        </div>

        <div class="col-6 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (Model.TotalResults == 0)
{
    <div class="alert alert-warning">
        <strong>No students found.</strong>
        @if (!Model.Criteria.IsEmpty)
        {
            <span>Try removing a filter or searching for a broader term.</span>
        }
        else
        {
            <span>No other students have listed any skills yet.</span>
        }
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-muted small">
            @Model.TotalResults student@(Model.TotalResults == 1 ? "" : "s") found
            &middot; page @Model.Page of @Model.TotalPages
        </div>
    </div>

    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var peer in Model.Results)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-1">
                                    <a asp-action="Profile" asp-route-id="@peer.StudentId"
                                       class="text-decoration-none">@peer.FullName</a>
                                </h5>
                                @if (!string.IsNullOrWhiteSpace(peer.Bio))
                                {
                                    <p class="text-muted small mb-0">@peer.Bio</p>
                                }
                            </div>
                            <div class="text-end">
                                <span class="badge @peer.MatchBadgeCss">@peer.MatchLabel</span>
                                @if (peer.MatchStrength > 0)
                                {
                                    <div class="small text-muted mt-1">@peer.MatchStrength% overlap</div>
                                }
                            </div>
                        </div>

                        @if (peer.TeachesWhatIWant.Any())
                        {
                            <div class="mb-2">
                                <div class="small fw-semibold text-success">Can teach you</div>
                                @foreach (var skill in peer.TeachesWhatIWant)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success me-1 mb-1">
                                        @skill.SkillName &middot; @skill.Level
                                    </span>
                                }
                            </div>
                        }

                        @if (peer.WantsWhatICanTeach.Any())
                        {
                            <div class="mb-2">
                                <div class="small fw-semibold text-primary">Wants to learn from you</div>
                                @foreach (var skill in peer.WantsWhatICanTeach)
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary me-1 mb-1">
                                        @skill.SkillName
                                    </span>
                                }
                            </div>
                        }

                        @if (peer.SharedGoals.Any())
                        {
                            <div class="mb-2">
                                <div class="small fw-semibold text-warning-emphasis">Also learning</div>
                                @foreach (var skill in peer.SharedGoals)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning me-1 mb-1">
                                        @skill.SkillName
                                    </span>
                                }
                            </div>
                        }

                        @if (peer.OtherSkills.Any())
                        {
                            <div class="mb-2">
                                <div class="small text-muted">Also teaches</div>
                                @foreach (var skill in peer.OtherSkills.Take(6))
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1">@skill.SkillName</span>
                                }
                                @if (peer.OtherSkills.Count > 6)
                                {
                                    <span class="small text-muted">+@(peer.OtherSkills.Count - 6) more</span>
                                }
                            </div>
                        }

                        <div class="small text-muted mt-2">
                            Teaches @peer.TotalSkillsTaught &middot; Learning @peer.TotalGoals
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="PageLink(Model.Page - 1)">Previous</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">@Model.Page / @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="PageLink(Model.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}
